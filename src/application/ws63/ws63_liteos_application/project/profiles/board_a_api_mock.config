# Bench-only HTTP firmware. Point host and Wi-Fi at the machine running mock_device_backend.py.
CLEARCHAIN_DISPLAY_SLE_SERVER=y
CLEARCHAIN_DISPLAY_SLE_LINK_TEST=n
CLEARCHAIN_DEVICE_API=y
CLEARCHAIN_DEVICE_HOST="192.168.4.1"
CLEARCHAIN_DEVICE_PORT=5000
SAMPLE_ENABLE=n
SPI_SUPPORT_MASTER=n
CLEARCHAIN_UPLOAD_ENABLED=y
CLEARCHAIN_BACKEND_CONFIRMED=y
